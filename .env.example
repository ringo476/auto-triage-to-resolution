# App General Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_TARGET_REPO=C:/path/to/repo/you/want/SentinelOps/to/debug

# Ollama / LLM Configuration (runs locally - no API key needed)
# Embeddings for RAG always use Ollama regardless of LLM_PROVIDER below.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chat model for the reasoning/tool-calling nodes (repro, triage, code fix).
# "ollama" (default, fully local) or "gemini" (needs GOOGLE_API_KEY, sends
# the bug report + code the agent inspects to Google — not the whole KB).
LLM_PROVIDER=ollama
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Database (Postgres + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/triage_db

# GitHub (mandatory - used for opening the automated fix PRs)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BASE_BRANCH=main

# Webhook auth (mandatory - required by /api/webhook/bug_report)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Slack (optional - only needed for the /api/webhook/slack path and USER_ERROR replies)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Jira (optional - only needed for the JIRA_TICKET routing path)
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=BUG
